{
  "name": "dsh-cd",
  "version": "0.2.0",
  "description": "Session working-directory override for DeepSeek Harness: a `cd` tool that makes relative paths in the file tools and the bash tool's default workdir follow the new directory, per-session and cache-safe, without moving the session or its workspace root. dsh-cd：给 DSH 补一个会话内原地切换工作目录的 `cd` 工具——文件工具的相对路径与 bash 默认工作目录跟随新目录，按会话隔离、cache 安全，且不改变会话身份与工作区根。",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check",
    "release": "npm run test && npm version patch && npm pack --pack-destination /tmp",
    "e2e:cd": "dsh-e2e run e2e/cd-tool.mjs",
    "e2e:workspace": "dsh-e2e run e2e/workspace-switch.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "cd",
    "working-directory",
    "cwd",
    "directory-switch",
    "relative-path",
    "session",
    "shell",
    "工作目录",
    "切换目录",
    "相对路径",
    "会话目录"
  ],
  "author": "johnnren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/john-walks-slow/dsh-cd.git"
  },
  "homepage": "https://github.com/john-walks-slow/dsh-cd#readme",
  "bugs": {
    "url": "https://github.com/john-walks-slow/dsh-cd/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": "^0.1.5-rc.3 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.3 || ^0.2.0-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
